# URL del backend (API de Pilas). Copia este archivo a .env y ajústalo.
#
# Desarrollo local:
VITE_API_URL=http://localhost:8000
#
# Producción (Render): tras desplegar con render.yaml, usa la URL pública.
# Ejemplo:
# VITE_API_URL=https://pilas-api.onrender.com

# ── Firebase Authentication (Centro de Mando gubernamental) ──────────────────
# El tablero de gobierno (gobierno.html) exige inicio de sesión. Con estas
# variables usa Firebase Auth (email + contraseña). Si se dejan vacías, el
# tablero cae a un «modo demo» local que igual pide credenciales pero no valida
# contra un proyecto real (útil solo para desarrollo).
#
# Consíguelas en la consola de Firebase → Configuración del proyecto → Tus apps.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=tu-proyecto
# VITE_FIREBASE_APP_ID=

# Cuenta «master» del Centro de Mando: la única que puede dar de alta y baja
# usuarios. El acceso del resto se controla con el allowlist en Firestore
# (colección gov_users). Debe coincidir con el correo de firestore.rules.
# VITE_GOV_MASTER_EMAIL=nombre@cali.gov.co
